# Legacy single-athlete layout only. With profiles (recommended), each athlete's settings live in
# profiles/<name>/.env, created by `cyp profile add <name>`; this root .env is then NOT read.
CYP_PROFILE=                    # select a profile (else profiles/.default)
CYP_FEATURES=                   # one-off flag overrides, e.g. publish.calendar=off (docs/09)

# ---- Strava (https://www.strava.com/settings/api) ----
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8721/callback
STRAVA_SCOPE=activity:read_all,profile:read_all
# Only needed when running `cyp serve` with webhooks enabled
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_ENABLED=true           # legacy switch for feature sync.strava
STRAVA_MAX_DETAIL_FETCHES=60  # detail + fallback-stream reads per run (~90 reads / 15 min budget)

# ---- intervals.icu (Settings -> Developer -> API key) ----
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0          # 0 = the key owner

# ---- Storage ----
CYP_DATA_DIR=data               # sqlite db, parquet streams, tokens, logs
CYP_DB_URL=sqlite:///data/cyp.sqlite

# ---- Planner behaviour ----
CYP_PLAN_HORIZON_DAYS=14
CYP_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # frontend dev servers
CYP_API_TOKEN=                  # optional: require "Authorization: Bearer <token>" on /v1 (set when serving beyond localhost)
CYP_PLAN_MODE=propose           # DEPRECATED, ignored: write mode is athlete.yaml planner.mode
CYP_TIMEZONE=Asia/Taipei

# ---- Optional LLM coach narrative ----
ANTHROPIC_API_KEY=
CYP_LLM_MODEL=claude-sonnet-5-5
