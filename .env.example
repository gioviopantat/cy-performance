# ---- Strava (https://www.strava.com/settings/api) ----
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8721/callback
STRAVA_SCOPE=activity:read_all,profile:read_all
# Only needed when running `cyp serve` with webhooks enabled
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_ENABLED=true           # false = skip Strava entirely (segments/PRs only source)
STRAVA_MAX_DETAIL_FETCHES=60  # detail + fallback-stream reads per run (~90 reads / 15 min budget)

# ---- intervals.icu (Settings -> Developer -> API key) ----
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0          # 0 = the key owner

# ---- Storage ----
CYP_DATA_DIR=data               # sqlite db, parquet streams, tokens, logs
CYP_DB_URL=sqlite:///data/cyp.sqlite

# ---- Planner behaviour ----
CYP_PLAN_HORIZON_DAYS=14
CYP_PLAN_MODE=propose           # propose | apply   (propose = write diff only, never touch calendar)
CYP_TIMEZONE=Asia/Taipei

# ---- Optional LLM coach narrative ----
ANTHROPIC_API_KEY=
CYP_LLM_MODEL=claude-sonnet-5-5
CYP_LLM_ENABLED=false
